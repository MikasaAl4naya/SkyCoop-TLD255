<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SkyCoop - multiplayer mod for The Long Dark.

    The project builds against the Il2Cpp interop assemblies published on NuGet, so a local
    game installation is NOT required to compile. The game version that is targeted is
    controlled by $(TLDVersion) below; bump it when Hinterland ships a new build.

    If you would rather build against your own installation, pass
        dotnet build -p:UseLocalGameAssemblies=true -p:TLDPath="C:\Path\To\TheLongDark"
    and the interop assemblies from <TLDPath>\MelonLoader\Il2CppAssemblies are used instead.
  -->

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>SkyCoop</AssemblyName>
    <RootNamespace>SkyCoop</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Configurations>Debug;Release;Dedicated;Dedicated Linux</Configurations>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <DebugType>portable</DebugType>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- The Long Dark version whose Il2Cpp assemblies this build targets. -->
    <TLDVersion Condition="'$(TLDVersion)' == ''">2.55.0</TLDVersion>
    <UseLocalGameAssemblies Condition="'$(UseLocalGameAssemblies)' == ''">false</UseLocalGameAssemblies>
    <!-- Il2Cpp interop assemblies are full of members that only differ by nullability/obsolete
         metadata; those warnings would bury real ones. -->
    <NoWarn>$(NoWarn);CS0108;CS0114;CS0162;CS0168;CS0169;CS0219;CS0414;CS0618;CS0649;CS0672;CS1591;CS8600;CS8602;CS8603;CS8618;CS8625</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DefineConstants>$(DefineConstants);TRACE;DEBUG</DefineConstants>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DefineConstants>$(DefineConstants);TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Dedicated' ">
    <DefineConstants>$(DefineConstants);DEDICATED</DefineConstants>
    <OutputPath>bin\Dedicated\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Dedicated Linux' ">
    <DefineConstants>$(DefineConstants);DEDICATED;DEDICATED_LINUX</DefineConstants>
    <OutputPath>bin\Dedicated Linux\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="bin\**" />
    <Compile Remove="obj\**" />
  </ItemGroup>

  <!-- The interop package ships both the split UnityEngine.*Module assemblies and the legacy
       UnityEngine.dll facade that forwards to them, which makes every type defined in both
       ambiguous. Drop the facade. -->
  <Target Name="DropUnityEngineFacade" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferencePath Remove="@(ReferencePath)" Condition="'%(Filename)' == 'UnityEngine'" />
    </ItemGroup>
  </Target>

  <!-- Game + loader assemblies straight from NuGet (no game install needed). -->
  <ItemGroup Condition=" '$(UseLocalGameAssemblies)' != 'true' ">
    <PackageReference Include="STBlade.Modding.TLD.Il2CppAssemblies.Windows" Version="$(TLDVersion)" />
  </ItemGroup>

  <!-- Steam lobby support. The game only ships a trimmed Steamworks.NET without the
       matchmaking API, so the mod carries the full managed binding itself (it is shipped
       next to SkyCoop.dll, in MelonLoader's UserLibs folder). -->
  <ItemGroup>
    <PackageReference Include="Steamworks.NET" Version="2024.8.0" />
  </ItemGroup>

  <!-- Alternatively, reference the assemblies of a local installation. -->
  <ItemGroup Condition=" '$(UseLocalGameAssemblies)' == 'true' ">
    <Reference Include="$(TLDPath)\MelonLoader\Il2CppAssemblies\*.dll" />
    <Reference Include="$(TLDPath)\MelonLoader\net6\MelonLoader.dll" />
    <Reference Include="$(TLDPath)\MelonLoader\net6\Il2CppInterop.Runtime.dll" />
    <Reference Include="$(TLDPath)\MelonLoader\net6\0Harmony.dll" />
  </ItemGroup>

</Project>
